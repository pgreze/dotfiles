# theme = Catppuccin Macchiato
theme = Catppuccin Mocha

# Font
font-family = "JetBrainsMono Nerd Font"
font-size = 14

# System
window-decoration = true
background-blur-radius = 20
window-padding-x = 10
window-padding-y = 10
mouse-hide-while-typing = true

# OSX
macos-option-as-alt = true
macos-titlebar-style = hidden

# Shell Integration
shell-integration = zsh
#command = /bin/zsh -l

# Keybindings

# Cmd+shift+r collide with raycast and/or Notion so keep default one.
#keybind = super+shift+r=reload_config

# Herdr integration: let Herdr own tabs, splits and panes with iTerm2-style Cmd chords.
# See https://suraj.io/post/2026/ghostty-as-a-shell-for-herdr/
# Herdr enables the Kitty keyboard protocol, so it sees Cmd once Ghostty releases a chord.
keybind = cmd+t=unbind
keybind = cmd+shift+t=unbind
keybind = cmd+w=unbind
keybind = cmd+n=unbind
keybind = cmd+shift+w=unbind

# Splits are Cmd+\ and Cmd+- in Herdr; Cmd+D stays unbound to avoid native Ghostty splits.
keybind = cmd+backslash=unbind
keybind = cmd+minus=unbind
keybind = cmd+d=unbind
keybind = cmd+shift+d=unbind
keybind = cmd+shift+enter=unbind
# Cmd+- used to shrink the font.
keybind = cmd+shift+minus=decrease_font_size:1

keybind = cmd+alt+left=unbind
keybind = cmd+alt+down=unbind
keybind = cmd+alt+up=unbind
keybind = cmd+alt+right=unbind

keybind = cmd+shift+up=unbind
keybind = cmd+shift+down=unbind
keybind = cmd+ctrl+up=unbind
keybind = cmd+ctrl+down=unbind

# Some chords must be sent as raw Kitty key events: ESC [ codepoint ; mods u,
# with mods = 1 + Shift(1) + Alt(2) + Ctrl(4) + Cmd(8).
# Number keys need both the character (cmd+1) and physical (cmd+Digit1) triggers
# because Ghostty binds both for its native tabs.
keybind = cmd+shift+left_bracket=text:\x1b[91:123;10u
keybind = cmd+shift+right_bracket=text:\x1b[93:125;10u

# Cmd+Left/Right switch Herdr tabs; Ctrl+A / Ctrl+E still jump to line start/end.
keybind = cmd+left=unbind
keybind = cmd+right=unbind

# Cmd+1..9 -> Herdr tabs
keybind = cmd+1=text:\x1b[49;9u
keybind = cmd+Digit1=text:\x1b[49;9u
keybind = cmd+2=text:\x1b[50;9u
keybind = cmd+Digit2=text:\x1b[50;9u
keybind = cmd+3=text:\x1b[51;9u
keybind = cmd+Digit3=text:\x1b[51;9u
keybind = cmd+4=text:\x1b[52;9u
keybind = cmd+Digit4=text:\x1b[52;9u
keybind = cmd+5=text:\x1b[53;9u
keybind = cmd+Digit5=text:\x1b[53;9u
keybind = cmd+6=text:\x1b[54;9u
keybind = cmd+Digit6=text:\x1b[54;9u
keybind = cmd+7=text:\x1b[55;9u
keybind = cmd+Digit7=text:\x1b[55;9u
keybind = cmd+8=text:\x1b[56;9u
keybind = cmd+Digit8=text:\x1b[56;9u
keybind = cmd+9=text:\x1b[57;9u
keybind = cmd+Digit9=text:\x1b[57;9u

# Cmd+Ctrl+1..9 -> Herdr workspaces
keybind = cmd+ctrl+1=text:\x1b[49;13u
keybind = cmd+ctrl+Digit1=text:\x1b[49;13u
keybind = cmd+ctrl+2=text:\x1b[50;13u
keybind = cmd+ctrl+Digit2=text:\x1b[50;13u
keybind = cmd+ctrl+3=text:\x1b[51;13u
keybind = cmd+ctrl+Digit3=text:\x1b[51;13u
keybind = cmd+ctrl+4=text:\x1b[52;13u
keybind = cmd+ctrl+Digit4=text:\x1b[52;13u
keybind = cmd+ctrl+5=text:\x1b[53;13u
keybind = cmd+ctrl+Digit5=text:\x1b[53;13u
keybind = cmd+ctrl+6=text:\x1b[54;13u
keybind = cmd+ctrl+Digit6=text:\x1b[54;13u
keybind = cmd+ctrl+7=text:\x1b[55;13u
keybind = cmd+ctrl+Digit7=text:\x1b[55;13u
keybind = cmd+ctrl+8=text:\x1b[56;13u
keybind = cmd+ctrl+Digit8=text:\x1b[56;13u
keybind = cmd+ctrl+9=text:\x1b[57;13u
keybind = cmd+ctrl+Digit9=text:\x1b[57;13u

# Cmd+Ctrl+Alt+1..9 -> Herdr agents
keybind = cmd+ctrl+alt+1=text:\x1b[49;15u
keybind = cmd+ctrl+alt+Digit1=text:\x1b[49;15u
keybind = cmd+ctrl+alt+2=text:\x1b[50;15u
keybind = cmd+ctrl+alt+Digit2=text:\x1b[50;15u
keybind = cmd+ctrl+alt+3=text:\x1b[51;15u
keybind = cmd+ctrl+alt+Digit3=text:\x1b[51;15u
keybind = cmd+ctrl+alt+4=text:\x1b[52;15u
keybind = cmd+ctrl+alt+Digit4=text:\x1b[52;15u
keybind = cmd+ctrl+alt+5=text:\x1b[53;15u
keybind = cmd+ctrl+alt+Digit5=text:\x1b[53;15u
keybind = cmd+ctrl+alt+6=text:\x1b[54;15u
keybind = cmd+ctrl+alt+Digit6=text:\x1b[54;15u
keybind = cmd+ctrl+alt+7=text:\x1b[55;15u
keybind = cmd+ctrl+alt+Digit7=text:\x1b[55;15u
keybind = cmd+ctrl+alt+8=text:\x1b[56;15u
keybind = cmd+ctrl+alt+Digit8=text:\x1b[56;15u
keybind = cmd+ctrl+alt+9=text:\x1b[57;15u
keybind = cmd+ctrl+alt+Digit9=text:\x1b[57;15u
