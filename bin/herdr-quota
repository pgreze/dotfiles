#!/bin/zsh
# Print one line of Claude Code, LiteLLM and Cursor quota for the herdr tab bar,
# e.g. `CC 12% 3h · FBL 55% 4d · LLM $3/$40 · CRS $1/$20`: window, used percentage, time left before its reset.
# CC is the 5h session window; a model's weekly window is the model name without vowels, FBL for Fable.
# Each source is fetched at most once a minute; a failed fetch keeps the cached data.
refresh() { [[ -n $(find $1 -mmin -1 2>/dev/null) ]] || { curl -sf -m 5 ${@:2} >$1.tmp && mv $1.tmp $1 } }

claude=~/.cache/claude-usage.json
token=$(security find-generic-password -s "Claude Code-credentials" -w | jq -r .claudeAiOauth.accessToken)
refresh $claude https://api.anthropic.com/api/oauth/usage -H "Authorization: Bearer $token" -H "anthropic-beta: oauth-2025-04-20"

litellm=~/.cache/litellm-user-info.json
key=$(jq -r .provider.litellm.options.apiKey ~/.config/opencode/opencode.json)
refresh $litellm https://litellm.mercari.in/user/info -H "Authorization: Bearer $key"

cursor=~/.cache/cursor-usage.json
ctoken=$(security find-generic-password -s cursor-access-token -w 2>/dev/null)
refresh $cursor -X POST https://api2.cursor.sh/aiserver.v1.DashboardService/GetCurrentPeriodUsage -H "Authorization: Bearer $ctoken" -H 'Content-Type: application/json' -d '{}'

cc=$(jq -r '
  def left: if . < 3600 then "\(./60 | floor)m" elif . < 86400 then "\(./3600 | floor)h" else "\(./86400 | floor)d" end;
  [.limits[] | ((.resets_at // "") | sub("\\.[0-9]+"; "") | sub("\\+00:00$"; "Z") | try (fromdate - now) catch null) as $eta
    | (if $eta != null and $eta < 0 then 0 else .percent end) as $used
    | (if .group == "session" then "CC" elif .scope.model.display_name then (.scope.model.display_name | .[0:1] + (.[1:] | gsub("[aeiouAEIOU ]"; "")) | ascii_upcase) else "WK" end) as $label
    | "\($label) \($used)%" + (if $eta != null and $eta > 0 then " \($eta | left)" else "" end)]
  | join(" · ")' $claude 2>/dev/null)
llm=$(jq -r '.user_info | "LLM $\(.spend | round)/$\(.max_budget | round)"' $litellm 2>/dev/null)
# Cursor reports cents.
crs=$(jq -r '.planUsage | "CRS $\(.totalSpend / 100 | round)/$\(.limit / 100 | round)"' $cursor 2>/dev/null)
parts=($cc $llm $crs)
print -r -- ${(j: · :)parts}
