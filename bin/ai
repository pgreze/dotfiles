#!/usr/bin/env bash
# ai — multi-CLI launcher with profile selection
# To add a CLI: append to CLIS/CLI_LABELS, define <NAME_UPPER>_PROFILES array
#
# Use https://deepswe.datacurve.ai/ to identify the models optimizing accuracy/cost.

CLIS=("claude" "agy" "codex")
CLI_LABELS=("Claude" "Antigravity" "Codex")

# Profile format: "name|flags"
CLAUDE_PROFILES=(
    "fast|--model claude-opus-5 --effort low"
    "standard|--model claude-opus-5 --effort medium"
    "standard|--model claude-fable-5-1 --effort low"
    "slow|--model claude-opus-5 --effort high"
    "slow|--model claude-fable-5-1 --effort medium"
)
AGY_PROFILES=(
    "fast|--model gemini-3.8-flash --effort low"
    "standard|--model gemini-3.8-flash --effort medium"
    "slow|--model gemini-3.8-flash --effort high"
)
CODEX_PROFILES=(
    "fast|--model gpt-5.4-mini"
    "standard|--model gpt-5.4"
    "slow|--model gpt-5.5"
)

# Precompute uppercase CLI names for array lookups
CLI_VARS=()
for c in "${!CLIS[@]}"; do
    CLI_VARS+=("$(echo "${CLIS[$c]}" | tr '[:lower:]' '[:upper:]')_PROFILES")
done

# Build flat index of all (cli_idx|profile_idx) pairs
INDEX=()
SECTION_MID=()  # flat index of each CLI's middle profile
for c in "${!CLIS[@]}"; do
    var="${CLI_VARS[$c]}[@]"
    profiles=("${!var}")
    SECTION_MID+=($(( ${#INDEX[@]} + ${#profiles[@]} / 2 )))
    for p in "${!profiles[@]}"; do
        INDEX+=("$c|$p")
    done
done

cursor=${SECTION_MID[0]}
total=${#INDEX[@]}

draw() {
    printf '\033[H\033[J'
    printf '\n  \033[1;36mai\033[0m — select a profile\n\n'
    local prev_cli=-1
    for i in "${!INDEX[@]}"; do
        IFS='|' read -r c p <<< "${INDEX[$i]}"
        if [[ $c -ne $prev_cli ]]; then
            [[ $prev_cli -ge 0 ]] && printf '\n'
            printf '  \033[2m%s\033[0m\n' "${CLI_LABELS[$c]}"
            prev_cli=$c
        fi
        local var="${CLI_VARS[$c]}[$p]"
        IFS='|' read -r name flags <<< "${!var}"
        if [[ $i -eq $cursor ]]; then
            printf '  \033[1;33m›\033[0m \033[1m%-9s\033[0m \033[33m%s\033[0m\n' "$name" "$flags"
        else
            printf '    %-9s \033[2m%s\033[0m\n' "$name" "$flags"
        fi
    done
    printf '\n  \033[2m↑ ↓ navigate   ← → section Enter launch   q quit\033[0m\n'
}

restore() { printf '\033[?1049l\033[?25h'; }
trap restore EXIT
trap 'exit 130' INT TERM

printf '\033[?1049h\033[?25l'
draw

while true; do
    IFS= read -rsn1 key
    if [[ "$key" == $'\x1b' ]]; then
        IFS= read -rsn1 -t0.1 k2 || true
        [[ "$k2" == '[' ]] && { IFS= read -rsn1 -t0.1 k3 || true; key="[$k3"; }
    fi
    case "$key" in
        '[A') cursor=$(( (cursor - 1 + total) % total )) ;;
        '[B') cursor=$(( (cursor + 1) % total )) ;;
        '[C'|'[D')
            IFS='|' read -r c _ <<< "${INDEX[$cursor]}"
            [[ "$key" == '[C' ]] && c=$(( (c + 1) % ${#CLIS[@]} )) || c=$(( (c - 1 + ${#CLIS[@]}) % ${#CLIS[@]} ))
            cursor=${SECTION_MID[$c]}
            ;;
        $'\n'|$'\r'|'') break ;;
        q|Q) exit 0 ;;
    esac
    draw
done

restore
trap - EXIT

IFS='|' read -r c p <<< "${INDEX[$cursor]}"
var="${CLI_VARS[$c]}[$p]"
IFS='|' read -r _ flags <<< "${!var}"
IFS=' ' read -ra flags_arr <<< "$flags"
cli="${CLIS[$c]}"

printf '\033[2m  launching: %s %s\033[0m\n\n' "$cli" "$flags"
exec "$cli" "${flags_arr[@]}" "$@"
