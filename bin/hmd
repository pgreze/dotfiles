#!/bin/zsh
# Edit a Markdown file in Helix, with a live mdfried preview in a herdr pane on the right.
set -eu

[[ -n ${HERDR_PANE_ID:-} ]] || exec hx "$@"

file=${1:?usage: hmd <file.md>}
[[ -e $file ]] || : > "$file"
pane=$(herdr pane split --current --direction right --no-focus \
  --env "DOT_EXEC=${commands[mdfried]} --watch ${(q)file:A}" | jq -r .result.pane.pane_id)
trap 'herdr pane close "$pane" >/dev/null 2>&1' EXIT
hx "$file"
