#!/bin/zsh
# Herdr popup: pick a `claude agents` session, focus its pane or attach it in a new tab.
# Lists the active pane's project like `claude agents --cwd .`; ctrl-a lists every project.
# No login shell: ~/.zshenv already sets the PATH the herdr server lacks, and -l costs ~30ms.
set -eu

herdr=${HERDR_BIN_PATH:-herdr}
cwd=${HERDR_ACTIVE_PANE_CWD:-$PWD}

# Prints "<pane> <tab>" of the herdr pane showing a session, from its session id, short id and name.
# Attach panes carry no session id: agent view panes take the attached session's name as title,
# and `claude attach` panes are found by their arguments.
find_pane() {
  local agents=$($herdr agent list) p t
  jq -r --arg s $1 --arg n $3 'first(.result.agents[] |
    select(.agent_session.value == $s or .terminal_title_stripped == $n) | "\(.pane_id) \(.tab_id)") // empty' <<< $agents |
    grep . && return
  [[ -n $2 ]] || return 0
  jq -r '.result.agents[] | select(.agent_session == null) | "\(.pane_id) \(.tab_id)"' <<< $agents |
    while read -r p t; do
      $herdr pane process-info --pane $p |
        jq -e --arg i $2 'any(.result.process_info.foreground_processes[]; .argv[-2:] == ["attach", $i])' >/dev/null &&
        { print -r -- "$p $t"; return }
    done
}

# Closes the tab before stopping, so an agent view tab doesn't fall back to its session list.
# `claude stop` takes ~300ms, so it runs after the tab is gone.
stop() {
  local tab=$1 id=$2
  [[ -z $tab ]] || $herdr tab close $tab >/dev/null
  [[ -z $id ]] || claude stop $id >/dev/null 2>&1 &!
}

case ${1-} in
  # fzf exports its prompt to reload commands, so the list stays in the mode ctrl-a picked.
  --list)
    filter=(--cwd $cwd)
    [[ ${FZF_PROMPT-} != All:* ]] || filter=()
    claude agents --json $filter |
      jq -r --arg home $HOME '.[] | [.sessionId, .id // "", .kind, .cwd, .name, (.state // .status // ""), (.cwd | sub("^" + $home; "~"))] | @tsv' |
      tee ${LIST_CACHE:-/dev/null}
    exit ;;
  # Drops the row from the cached list, so fzf redraws without waiting for `claude agents`.
  --stop)
    read -r _ tab <<< "$(find_pane $2 $3 $4)"
    stop "$tab" $3
    rows=(${(f)"$(<$LIST_CACHE)"})
    print -rl -- ${rows:#$2$'\t'*} > $LIST_CACHE
    exit ;;
esac

export LIST_CACHE=$(mktemp -t herdr-claude-agents.XXXXXX)
trap 'rm -f $LIST_CACHE' EXIT

# ctrl-x matches `claude agents`: the session stops, leaves the list, and its herdr tab closes.
line=$($0 --list |
  fzf --reverse --delimiter '\t' --with-nth 5,6,7 --prompt "${cwd/#$HOME/~}: " \
  --header 'ctrl-a: all projects · ctrl-x: stop session' \
  --bind "ctrl-a:change-prompt(All: )+reload($0 --list)" \
  --bind "ctrl-x:execute-silent($0 --stop {1} {2} {5})+reload(cat $LIST_CACHE)") || exit 0
IFS=$'\t' read -r sid id kind dir name _ <<< $line

read -r pane _ <<< "$(find_pane $sid "$id" $name)"
if [[ -n $pane ]]; then
  $herdr agent focus $pane >/dev/null
  exit
fi

if [[ $kind != background ]]; then
  print "$name runs outside herdr and can't be attached."
  read -sk1
  exit 1
fi

# ponytail: same exact-directory workspace match as herdr-claude-tab.
ws=$($herdr agent list |
  jq -r --arg d $dir 'first(.result.agents[] | select(.foreground_cwd == $d) | .workspace_id) // empty')

pane=$($herdr tab create --workspace "${ws:-$HERDR_ACTIVE_WORKSPACE_ID}" --cwd $dir --label $name --focus |
  jq -r .result.root_pane.pane_id)
# exec so the tab closes once the session stops, from this popup or from `claude agents`.
$herdr pane send-text $pane "exec claude attach $id"
$herdr pane send-keys $pane enter
